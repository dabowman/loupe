#!/bin/sh
# loupe, on PATH.
#
# Claude Code adds each enabled plugin's top-level bin/ to the environment it
# runs commands in, so this shim is reachable by name from any project without
# an alias, an npm link, or anything added to the project itself. install.sh
# also links it into ~/.local/bin for plain terminals.
#
# Both routes reach it through a symlink, but different ones: Claude Code
# symlinks the plugin *directory*, ~/.local/bin symlinks this *file*. `cd -P`
# resolves the first and not the second, so the link chain is walked explicitly
# — otherwise the ~/.local/bin route looks for the engine in ~/.local/engine.
target=$0
while [ -L "$target" ]; do
	dir=$(dirname -- "$target")
	target=$(readlink -- "$target")
	case $target in
		/*) ;;
		*) target=$dir/$target ;;
	esac
done
here=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd -P)

# Default to the shipped design-system profiles, the same ones the hooks and
# commands pass. A profile only supplies its registries to a project that
# imports its packages, so pointing this at every project is safe: a repo on a
# different design system selects no profile and gets no registry.
#
# An explicit --profiles/--profile/--patterns still wins: the flag is only added
# when the caller named none of them.
case " $* " in
	*" --profiles "*|*" --profiles="*|*" --profile "*|*" --profile="*|*" --patterns "*|*" --patterns="*)
		exec node "$here/../engine/bin/loupe.mjs" "$@" ;;
esac
exec node "$here/../engine/bin/loupe.mjs" "$@" --profiles "$here/../profiles"
