{
	"$description": "A synthetic token set: tiers named outright, values in the pre-2025 string spellings, scales named by number.",
	"primitive": {
		"color": {
			"$type": "color",
			"slate": {
				"100": { "$value": "#f1f5f9" },
				"500": { "$value": "#64748b" },
				"900": { "$value": "#0f172a" }
			},
			"blue": { "500": { "$value": "#3b82f6" } }
		},
		"space": {
			"$type": "dimension",
			"1": { "$value": "4px" },
			"2": { "$value": "8px" },
			"4": { "$value": "1rem" }
		},
		"speed": {
			"$type": "duration",
			"quick": { "$value": "150ms" }
		}
	},
	"semantic": {
		"text": {
			"$type": "color",
			"default": { "$value": "{primitive.color.slate.900}", "$description": "Body copy and labels." },
			"muted": { "$value": "{primitive.color.slate.500}", "$description": "Help text, captions and metadata." }
		},
		"surface": {
			"$type": "color",
			"page": { "$value": "{primitive.color.slate.100}", "$description": "The page behind everything else." }
		},
		"action": {
			"$type": "color",
			"primary": { "$value": "{primitive.color.blue.500}", "$description": "The one affirmative action on a screen." }
		},
		"inset": {
			"$type": "dimension",
			"sm": { "$value": "{primitive.space.2}" },
			"md": { "$value": "{primitive.space.4}" }
		}
	},
	"component": {
		"button": {
			"padding-x": { "$type": "dimension", "$value": "{semantic.inset.md}" }
		}
	},
	"brand": {
		"partner-badge": { "$type": "color", "$value": "#ff4f00", "$description": "A partner's own orange. Not ours to change." }
	}
}
