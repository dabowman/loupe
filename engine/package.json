{
  "name": "@dvdbwmn/loupe",
  "version": "0.8.0",
  "description": "Design-system conformance checking: correlates markup bindings with the CSS that styles them.",
  "type": "module",
  "bin": {
    "loupe": "./bin/loupe.mjs"
  },
  "exports": {
    "./presets/*": "./presets/*.json"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "presets",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:check": "node build.mjs --check",
    "build:binary": "node scripts/build-binary.mjs",
    "build:binary:all": "node scripts/build-binary.mjs --all",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "patterns-doc": "node scripts/patterns-doc.ts",
    "patterns-doc:check": "node scripts/patterns-doc.ts --check",
    "eval:represents": "node evals/represents/run.ts",
    "eval:values": "node evals/values/run.ts",
    "eval:renames": "node evals/renames/run.ts",
    "test": "npm run lint && npm run typecheck && node tests/run.ts && node tests/detect.ts && node tests/regressions.ts && node tests/features.ts && node tests/autofix.ts && node tests/multi-ds.ts && node tests/report.ts && node tests/serve.ts && node tests/lsp.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "picomatch": "^4.0.0",
    "postcss": "^8.4.0"
  },
  "license": "MIT",
  "optionalDependencies": {
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.20.1",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
