{
  "name": "@dvdbwmn/loupe",
  "version": "0.7.0",
  "description": "Design-system conformance checking: correlates markup bindings with the CSS that styles them.",
  "type": "module",
  "bin": {
    "loupe": "./bin/loupe.mjs"
  },
  "exports": {
    "./presets/*": "./presets/*.json"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "presets",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:check": "node build.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "patterns-doc": "tsx scripts/patterns-doc.ts",
    "patterns-doc:check": "tsx scripts/patterns-doc.ts --check",
    "test": "npm run typecheck && tsx tests/run.ts && tsx tests/detect.ts && tsx tests/regressions.ts && tsx tests/features.ts && tsx tests/autofix.ts && tsx tests/multi-ds.ts && tsx tests/report.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "picomatch": "^4.0.0",
    "postcss": "^8.4.0"
  },
  "license": "MIT",
  "optionalDependencies": {
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@types/node": "^22.20.1",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
