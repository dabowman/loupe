{
  "extends": "generic",
  "designSystem": {
    "name": "WordPress",
    "packages": ["@wordpress/components", "@wordpress/ui"],
    "tokenPrefixes": ["--wp-admin-theme-", "--wp-components-"],
    "normalizeExports": "^__(experimental|unstable)",
    "components": {
      "layout": ["Stack", "Flex", "FlexBlock", "FlexItem", "HStack", "VStack", "Grid", "Spacer", "Divider"],
      "text": ["Text", "Heading", "Truncate"]
    },
    "elementMap": {
      "p": "Text",
      "h1": { "component": "Text", "render": "h1" },
      "h2": { "component": "Text", "render": "h2" },
      "h3": { "component": "Text", "render": "h3" },
      "h4": { "component": "Text", "render": "h4" },
      "h5": { "component": "Text", "render": "h5" },
      "h6": { "component": "Text", "render": "h6" },
      "div": { "component": "Stack", "styledOnly": true },
      "span": { "component": "Text", "styledOnly": true },
      "button": "Button",
      "input": {
        "component": "InputControl",
        "attribute": "type",
        "values": {
          "hidden": null,
          "checkbox": "CheckboxControl",
          "radio": "RadioControl",
          "search": "SearchControl",
          "file": "FormFileUpload",
          "range": "RangeControl",
          "submit": "Button", "button": "Button", "reset": "Button"
        }
      },
      "select": "SelectControl",
      "textarea": "TextareaControl",
      "table": "DataViews",
      "dialog": "Modal",
      "progress": "ProgressBar",
      "details": "Collapsible"
    }
  },
  "namespaces": {
    "external": [
      "components-", "wp-components-", "wp-block-", "wp-admin-", "wp-core-ui",
      "block-editor-", "editor-", "interface-",
      "edit-post-", "edit-site-", "dataviews-", "dashicon"
    ],
    "neverDead": [
      "has-*", "is-*", "wp-*", "alignwide", "alignfull", "alignleft",
      "alignright", "aligncenter", "screen-reader-text"
    ]
  },
  "sources": {
    "markup": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.cjs"],
    "references": [
      "**/*.php", "**/*.html", "**/block.json", "**/theme.json",
      "**/patterns/**/*.php", "**/patterns/**/*.html"
    ]
  }
}
