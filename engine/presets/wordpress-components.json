{
  "extends": "generic",
  "designSystem": {
    "name": "WordPress",
    "packages": ["@wordpress/components", "@wordpress/ui"],
    "tokenPrefixes": ["--wp-admin-theme-", "--wp-components-"],
    "normalizeExports": "^__(experimental|unstable)",
    "components": {
      "layout": ["Stack", "Flex", "FlexBlock", "FlexItem", "HStack", "VStack", "Grid", "Spacer", "Divider"],
      "text": ["Text", "Heading", "Truncate"]
    },
    "elementMap": {
      "p": "Text",
      "h1": "Heading", "h2": "Heading", "h3": "Heading",
      "h4": "Heading", "h5": "Heading", "h6": "Heading",
      "div": { "component": "Stack", "styledOnly": true },
      "span": { "component": "Text", "styledOnly": true }
    }
  },
  "namespaces": {
    "external": [
      "components-", "wp-components-", "wp-block-", "wp-admin-", "wp-core-ui",
      "block-editor-", "editor-", "interface-",
      "edit-post-", "edit-site-", "dataviews-", "dashicon"
    ],
    "neverDead": [
      "has-*", "is-*", "wp-*", "alignwide", "alignfull", "alignleft",
      "alignright", "aligncenter", "screen-reader-text"
    ]
  },
  "sources": {
    "markup": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.cjs"],
    "references": [
      "**/*.php", "**/*.html", "**/block.json", "**/theme.json",
      "**/patterns/**/*.php", "**/patterns/**/*.html"
    ]
  }
}
