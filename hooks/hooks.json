{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/engine/bin/loupe.mjs\" hook --profiles \"${CLAUDE_PLUGIN_ROOT}/profiles\" --judge",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/engine/bin/loupe.mjs\" hook --profiles \"${CLAUDE_PLUGIN_ROOT}/profiles\" --judge",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "modules": ["./register.tsx"]
}
